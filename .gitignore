__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/
# Local toolchain, downloads and render intermediates (not deliverables).
tools/
work/

# Large media artifacts from the YouTube downloader stay on disk; only the
# subtitle files and the folder metadata are tracked in the repository.
output/**/*.mp4
output/**/*.webm
output/**/*.m4a

# Local scratch directory for download tooling and logs.
.work/

# Proxy index: keep the tooling and the source list, not the multi-million-line pools.
proxyindex/raw.txt
proxyindex/proxies.txt
proxyindex/alive_tcp.txt
proxyindex/alive_http.txt
proxyindex/*.log
# Seed crawler database and its WAL sidecars.
proxyindex/*.sqlite3
proxyindex/*.sqlite3-*
