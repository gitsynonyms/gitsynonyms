__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/
# Local toolchain, downloads and render intermediates (not deliverables).
tools/
work/

# Large media artifacts from the YouTube downloader stay on disk; only the
# subtitle files and the folder metadata are tracked in the repository.
output/**/*.mp4
output/**/*.webm
output/**/*.m4a

# Local scratch directory for download tooling and logs.
.work/

# Proxy index: keep the tooling and the source list, not the multi-million-line pools.
proxyindex/raw.txt
proxyindex/proxies.txt
proxyindex/alive_tcp.txt
proxyindex/alive_http.txt
proxyindex/*.log
# Full list² scan working state: reproducible from the committed matrix code and
# the append-only source list. Published top10/report/state stay tracked, and so
# do the discovery cursor plus the de-duplicated repo list: those two are what
# make matrix/source coverage accumulate instead of restarting every run.
proxyindex/query-matrix.json
proxyindex/queries.txt
proxyindex/discovered.jsonl
proxyindex/sources.full.txt
proxyindex/collect.jsonl
proxyindex/pool.txt
proxyindex/pool.parts
proxyindex/pool.provenance.tsv
proxyindex/provenance.parts
proxyindex/tcp-probes.tsv
proxyindex/http-probes.tsv
proxyindex/*.merged
proxyindex/*.tmp
# Sharded multi-runner runs keep one workspace per runner; the merged artefacts
# in the index directory are the only ones worth keeping.
proxyindex/shard-*/
proxyindex/discovery-run/
# Workflow scratch: downloaded shard artifacts and the probe input slices.
/downloads/
/probe-input/
/probe/

# Monitor state and verification scratch.
output/.monitor-state.json
output/unknown_*/

# Module 1 acquisition state: the ledger and manifest are deliverables, the
# conditional-request cache and observation clock are local state.
output/materials/.http-cache.json
output/materials/.seen.json
