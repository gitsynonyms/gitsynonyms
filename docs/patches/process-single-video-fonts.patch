# Apply with: git apply docs/patches/process-single-video-fonts.patch
# Needs a token with the workflows permission (GitHub App: Workflows: Read and write).
# Contents: install fonts-noto-cjk/fonts-dejavu-core, drop the dead style_preset input.

diff --git a/.github/workflows/process-single-video.yml b/.github/workflows/process-single-video.yml
index b165bb3..ee45f6b 100644
--- a/.github/workflows/process-single-video.yml
+++ b/.github/workflows/process-single-video.yml
@@ -23,11 +23,6 @@ on:
         required: false
         type: string
         default: "zh-Hans,en-orig"
-      style_preset:
-        description: ASS style preset
-        required: false
-        type: string
-        default: "classic"
       no_burn_in:
         description: Skip burning subtitles into the MP4 (download only)
         required: false
@@ -74,7 +69,10 @@ jobs:
       - name: Install yt-dlp and FFmpeg
         run: |
           python -m pip install "yt-dlp[default]"
-          sudo apt-get update -y && sudo apt-get install -y ffmpeg
+          sudo apt-get update -y
+          # libass resolves the ASS families through fontconfig: without the CJK and
+          # Latin packages the bilingual Chinese line burns in as missing glyphs.
+          sudo apt-get install -y ffmpeg fonts-noto-cjk fonts-dejavu-core
           yt-dlp --version
           ffmpeg -version
 
@@ -94,7 +92,6 @@ jobs:
           OUTPUT_DIR: ${{ inputs.output_dir }}
           STATE_FILE: ${{ inputs.state_file }}
           LANGUAGES: ${{ inputs.languages }}
-          STYLE_PRESET: ${{ inputs.style_preset }}
           GH_TOKEN: ${{ github.token }}
         run: |
           set -euo pipefail
@@ -103,7 +100,6 @@ jobs:
             --output-dir "$OUTPUT_DIR"
             --state-file "$STATE_FILE"
             --languages "$LANGUAGES"
-            --style-preset "$STYLE_PRESET"
           )
           if [[ "${{ inputs.no_burn_in }}" == "true" ]]; then
             ARGS+=(--no-burn-in)
